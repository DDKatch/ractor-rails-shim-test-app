<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex items-start justify-between mb-4">
      <h1 class="text-3xl font-bold"><%= @post.title %></h1>
      <%= post_status_badge(@post) %>
    </div>

    <div class="text-sm text-gray-500 mb-4">
      by <%= @post.user&.email || "Unknown" %> &middot;
      <%= time_ago(@post.created_at) %>
      <% if @post.category %>
        &middot; <%= link_to @post.category.name, category_path(@post.category), class: "text-blue-500 hover:underline" %>
      <% end %>
    </div>

    <div class="prose max-w-none mb-6">
      <%= simple_format(@post.body) %>
    </div>

    <% if user_signed_in? && @post.user == current_user %>
      <div class="flex gap-2 border-t pt-4">
        <%= link_to t("shared.edit"), edit_post_path(@post), class: "text-blue-600 hover:underline" %>
        <%= button_to t("shared.delete"), @post, method: :delete, data: { turbo_confirm: t("shared.confirm_delete") }, class: "text-red-600 hover:underline bg-transparent border-none cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <%= render "comments/comments", post: @post %>

  <%= link_to t("shared.back"), posts_path, class: "text-blue-600 hover:underline mt-6 inline-block" %>
</div>
