<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold"><%= t("shared.nav_categories") %></h1>
    <% if user_signed_in? %>
      <%= link_to "New Category", new_category_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @categories.each do |category| %>
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold mb-2">
          <%= link_to category.name, category_path(category), class: "text-blue-600 hover:underline" %>
        </h2>
        <p class="text-gray-600 mb-4"><%= truncate_with_length(category.description, length: 150) %></p>
        <div class="text-sm text-gray-500">
          <%= pluralize(category.posts.count, "post") %>
        </div>
      </div>
    <% end %>
  </div>
</div>
